@startuml
skinparam linetype ortho
skinparam backgroundColor #FFFFFF
skinparam classAttributeIconSize 0

enum ItemSize {
    S
    M
    L
    XL
    XXL
}

enum Color {
    Red
    Green
    Blue
    Rainbow
    Black
    White
    Grey
}

enum OrderStatus {
    pending
    checkout
    completed
    cancelled
}

class User {
    + id: int <<PK>>
    + name: string
    + email: string
    + avatar: string
    + contact: string
    + address: string
    + description: string
    + updatedAt: dateTime
}

class Authen {
    + id: int <<PK>>
    + userId: int <<FK>> <<unique>>
    + username: string
    + email: string
    + password: string
}

class Product {
    + id: int <<PK>>
    + title: string
    + description: string
    + rating: decimal
    + numReviews: int
    + image: string
    + updatedAt: dateTime
}

class ProductStock {
    + id: int <<PK>>
    + productId: int <<FK>>
    + size: ItemSize
    + color: Color
    + originalPrice: decimal
    + promotionPrice: decimal
    + stock: int
}

class Comment {
    + id: int <<PK>>
    + userId: int <<FK>>
    + productId: int <<FK>>
    + content: string
    + rating: int
    + updatedAt: dateTime
}

class Cart {
    + id: int <<PK>>
    + userId: int <<FK>> <<unique>>
    + updatedAt: dateTime
}

class CartItem {
    + id: int <<PK>>
    + cartId: int <<FK>>
    + stockId: int <<FK>>
    + quantity: int
    + updatedAt: dateTime
}

class Order {
    + id: int <<PK>>
    + userId: int <<FK>>
    + status: OrderStatus
    + subtotal: decimal
    + discount: decimal
    + deliveryFee: decimal
    + total: decimal
    + promoCode: string
    + createdAt: dateTime
    + updatedAt: dateTime
}

class OrderItem {
    + id: int <<PK>>
    + orderId: int <<FK>>
    + stockId: int <<FK>>
    + title: string
    + image: string
    + quantity: int
    + priceAtPurchase: decimal
    + totalPrice: decimal
    + updatedAt: dateTime
}

' Relationships
User ||--o{ Comment : "writes"
Product ||--o{ Comment : "has"

User ||--|| Authen : "authenticates"
User ||--|| Cart : "owns"
Cart ||--|{ CartItem : "contains"

Product ||--|{ ProductStock : "has variants"
ProductStock ||--o{ CartItem : "selected in"

User ||--o{ Order : "places"
Order ||--|{ OrderItem : "includes"
ProductStock ||--o{ OrderItem : "ordered as"

@enduml