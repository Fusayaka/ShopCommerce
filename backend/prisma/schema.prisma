generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(50)
  email       String    @unique @db.VarChar(50)
  avatar      String?   @db.VarChar(255)
  contact     String?   @db.VarChar(20)
  address     String?   @db.VarChar(255)
  description String?
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  authen      Authen?
  cart        Cart?
  comments    Comment[]
  orders      Order[]

  @@map("users")
}

model Authen {
  id       Int     @id @default(autoincrement())
  userId   Int     @unique @map("user_id")
  username String? @unique @db.VarChar(50)
  email    String  @unique @db.VarChar(50)
  password String  @db.VarChar(255)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("authen")
}

model Product {
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(100)
  description String?
  rating      Decimal?       @default(0) @db.Decimal(2, 1)
  numReviews  Int            @default(0) @map("num_reviews")
  image       String?        @db.VarChar(255)
  updatedAt   DateTime?      @default(now()) @map("updated_at") @db.Timestamp(6)
  comments    Comment[]
  stocks      ProductStock[]

  @@map("products")
}

model ProductStock {
  id             Int         @id @default(autoincrement())
  productId      Int         @map("product_id")
  size           ItemSize
  color          Color
  originalPrice  Decimal     @map("original_price") @db.Decimal(10, 2)
  promotionPrice Decimal?    @map("promotion_price") @db.Decimal(10, 2)
  stock          Int         @default(0)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([productId, size, color])
  @@map("product_stocks")
}

model Comment {
  id        Int       @id @default(autoincrement())
  productId Int       @map("product_id")
  userId    Int       @map("user_id")
  content   String
  rating    Int
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("comments")
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique @map("user_id")
  updatedAt DateTime?  @default(now()) @map("updated_at") @db.Timestamp(6)
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("carts")
}

model CartItem {
  id        Int          @id @default(autoincrement())
  cartId    Int          @map("cart_id")
  stockId   Int          @map("stock_id")
  quantity  Int          @default(1)
  updatedAt DateTime?    @default(now()) @map("updated_at") @db.Timestamp(6)
  cart      Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stock     ProductStock @relation(fields: [stockId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([cartId, stockId])
  @@map("cart_items")
}

model Order {
  id          Int         @id @default(autoincrement())
  userId      Int         @map("user_id")
  status      OrderStatus @default(pending)
  subtotal    Decimal     @default(0) @db.Decimal(10, 2)
  discount    Decimal     @default(0) @db.Decimal(10, 2)
  deliveryFee Decimal     @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  total       Decimal?    @default(dbgenerated("((subtotal - discount) + delivery_fee)")) @db.Decimal(10, 2)
  promoCode   String?     @map("promo_code") @db.VarChar(20)
  createdAt   DateTime?   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime?   @default(now()) @map("updated_at") @db.Timestamp(6)
  items       OrderItem[]
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("orders")
}

model OrderItem {
  id              Int           @id @default(autoincrement())
  orderId         Int           @map("order_id")
  stockId         Int?          @map("stock_id")
  title           String        @db.VarChar(100)
  image           String?       @db.VarChar(255)
  quantity        Int           @default(1)
  priceAtPurchase Decimal       @map("price_at_purchase") @db.Decimal(10, 2)
  totalPrice      Decimal?      @default(dbgenerated("(price_at_purchase * (quantity)::numeric)")) @map("total_price") @db.Decimal(10, 2)
  updatedAt       DateTime?     @default(now()) @map("updated_at") @db.Timestamp(6)
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stock           ProductStock? @relation(fields: [stockId], references: [id], onUpdate: NoAction)

  @@map("order_items")
}

enum ItemSize {
  S
  M
  L
  XL
  XXL

  @@map("item_size")
}

enum Color {
  Red
  Green
  Blue

  @@map("color")
}

enum OrderStatus {
  pending
  checkout
  completed
  cancelled

  @@map("order_status")
}
